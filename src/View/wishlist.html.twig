{% extends "base.html.twig" %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %} 
<section class="layout-principal">
    <div class="liste-offres">
        <h1>Ma Wish-list</h1>

        <div class="wishlist-container">
            {% if offres is empty %}
                <p>Votre wish-list est vide pour le moment.</p>
                <a href="{{ path('app_home') }}" class="btn" style="display: inline-block; padding: 10px; background: #007bff; color: white; text-decoration: none; border-radius: 5px;">Parcourir les offres</a>
            {% else %}
                <div class="offres-grid">
                    {% for offre in offres %}
                        <article class="offre-card" style="border: 1px solid #ddd; margin-bottom: 15px; padding: 15px; border-radius: 8px;">
                            <div class="offre-header">
                                <h3>{{ offre.CompanyName|default('Entreprise non précisée') }}</h3>
                                <p class="offre-title" style="font-weight: bold; color: #333;">{{ offre.Title }}</p>
                            </div>
                            
                            <div class="offre-actions" style="margin-top: 10px;">
                                {# Bouton pour retirer l'offre (SFx 25) #}
                                <a href="{{ path('app_wishlist_del', {'id': offre.ID_offer}) }}" class="btn-delete" style="color: #dc3545; text-decoration: none; border: 1px solid #dc3545; padding: 5px 10px; border-radius: 4px; font-size: 0.9em;">
                                    🗑️ Retirer de la liste
                                </a>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}