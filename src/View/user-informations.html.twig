{% extends 'base.html.twig' %}

{% block content %}
    <div class="layout-principal">
        
        <section class="liste-offres">
            
            {% if user != null %}
                <article class="offre-card">
                    <div class="offre-header">
                        <img src="../Asset/img/image.png" alt="logo" class="logo">
                        <h3>{{ user.Name|default('Utilisateur') }} {{ user.Lastname|upper }}</h3>
                        <p class="offre-title">{{ user.Email }}</p>
                    </div>

                    <div class="offre-details">
                        {% if user.status %}
                            <h4 class="badge-status">Statut : {{ user.status }}</h4>
                        {% endif %}
                        
                        {% if user.Phone_number %}
                            <h4>📞 {{ user.Phone_number }}</h4>
                        {% endif %}
                    </div>
                </article>

        </section>
        <aside class="sidebar">
            <div class="widget alert-widget">
                <h3>Options</h3>
                <form action="" method="post">
                    <button type="submit" class="btn-supprimer">Modifier le compte</button>
                </form>
                <form action="/admin/utilisateurs/delete/{{ user.ID_user }}" method="post" onsubmit="return confirm('Supprimer cet utilisateur ?')">
                    <button type="submit" class="btn-supprimer onsubmit="return confirm('Supprimer cet utilisateur ?')">Supprimer le compte</button>
                </form>
            </div>
        </aside>  
            {% else %}
                <p>Aucun utilisateur trouvé dans la base de données.</p>
            {% endif %}
 
    </div>
{% endblock %}