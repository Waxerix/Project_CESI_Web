{% extends "base.html.twig" %}
{% block title %}
    {{ page_title }}
{% endblock %}
{% block content %}
    <section class="layout-principal">
        <div class="liste-offres">
            <h1>
                Ma Wish-list
            </h1>
            <div class="wishlist-container">
                {% if offres is empty %}
                    <p>
                        Votre wish-list est vide pour le moment.
                    </p>
                    <a href="/" class="btn" style="display: inline-block; padding: 10px; background: #007bff; color: white; text-decoration: none; border-radius: 5px;">
                        Parcourir les offres
                    </a>
                {% else %}
                    <div class="offres-grid">
                        {% for offre in offres %}
                            <article class="offre-card">
                                <div class="offre-header">
                                    <h3>
                                        {{ offre.CompanyName|default('Entreprise non précisée') }}
                                    </h3>
                                    <p class="offre-title">
                                        {{ offre.Title }}
                                    </p>
                                </div>
                                <div class="offre-details">
                                    {% if offre.Duration %}
                                        <h4>
                                            {{ offre.Duration }}
                                            mois
                                        </h4>
                                    {% endif %}
                                    {% if offre.Salary %}
                                        <h4>
                                            {{ offre.Salary }}
                                            €
                                        </h4>
                                    {% endif %}
                                    {% if offre.Category %}
                                        <h4>
                                            {{ offre.Category }}
                                        </h4>
                                    {% endif %}
                                </div>
                                <div class="offre-actions">
                        <a href="/postuler/{{ offre.ID_offer }}" class="btn-postuler">
                            Postuler
                        </a>
                        <button class="btn-heart" data-id="{{ offre.ID_offer }}">
                            <svg viewBox="0 0 24 24" width="28" height="28">
                                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                            </svg>
                        </button>
                    </div>
                                </article>
                            {% else %}
                                <p>
                                    Votre Wishlist est vide.
                                </p>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </section>
    {% endblock %}
    {% block javascripts %}
        <script src="../js/wishlist.js"></script>
    {% endblock %}