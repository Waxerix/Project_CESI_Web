{% extends 'base.html.twig' %}

{% block content %}
<main class="main-centered">
    <section class="form-section company-list-section">
        <h2 class="page-title">Liste des Entreprises</h2>

        <div class="form-card">
            <table class="company-table">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {# Setup pagination #}
                    {% set per_page = 10 %}
                    {% set total_pages = (companies|length / per_page)|round(0, 'ceil') %}
                    {% set current_page = current_page is defined ? current_page : 1 %}
                    {% set paged_companies = companies|slice((current_page - 1) * per_page, per_page) %}

                    {% for company in paged_companies %}
                        <tr>
                        <td>{{ company.Name }}</td>
                        <td>{{ company.Email }}</td>
                        <td>{{ company.Phone_Number }}</td>
                        <td class="text-center">
                            <a href="/admin/entreprises/delete/{{ company.ID_company }}" 
                               class="btn-delete"
                               onclick="return confirm('Voulez-vous vraiment supprimer l\'entreprise {{ company.Name }} ?')">
                                Supprimer
                            </a>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="4" class="empty-msg">
                            Aucune entreprise enregistrée.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if total_pages > 1 %}
            <nav class="pagination">
                {% if current_page > 1 %}
                    <a href="?page={{ current_page - 1 }}" class="pagination-btn">&laquo; Précédent</a>
                {% else %}
                    <span class="pagination-btn disabled">&laquo; Précédent</span>
                {% endif %}

                {% for page in 1..total_pages %}
                    {% if page == current_page %}
                        <span class="pagination-btn active">{{ page }}</span>
                    {% else %}
                        <a href="?page={{ page }}" class="pagination-btn">{{ page }}</a>
                    {% endif %}
                {% endfor %}

                {% if current_page < total_pages %}
                    <a href="?page={{ current_page + 1 }}" class="pagination-btn">Suivant &raquo;</a>
                {% else %}
                    <span class="pagination-btn disabled">Suivant &raquo;</span>
                {% endif %}
            </nav>
        {% endif %}

            <div class="back-link-container">
                <a href="/admin/entreprises" class="link-blue">← Retour au menu gestion</a>
            </div>
        </div>
    </section>
</main>
{% endblock %}