{% extends 'base.html.twig' %}

{% block content %}
<main class="main-centered">
    <section class="form-section">
        <h2 class="page-title">Gestion des Entreprises</h2>
        
        <div class="form-card" style="display: flex; flex-direction: column; gap: 20px; padding: 40px;">
            {# 기업 등록 페이지로 이동 #}
            <a href="/admin/entreprises/create" class="btn-submit" style="text-align: center; text-decoration: none; display: block;">
                Créer une nouvelle entreprise
            </a>

            {# 기업 리스트 페이지로 이동 #}
            <a href="/admin/entreprises/list" class="btn-submit" style="text-align: center; text-decoration: none; display: block; background-color: #555;">
                Voir la liste des entreprises
            </a>
        </div>
    </section>
</main>
{% endblock %}