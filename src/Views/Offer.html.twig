{% extends 'base.html.twig' %}

{% block content %}
<div class="page-header-centered">
    <h1>Toutes nos offres d'emploi</h1>
    <p>Trouvez le poste qui correspond à vos attentes.</p>
</div>

<div class="layout-offres">
    
    <aside class="sidebar-filtres">
        <form action="/offer" method="GET" class="form-card">
            <h2>Filtres</h2>
            
            <input type="hidden" name="q" value="{{ app.request.get('q') }}">

            <div class="input-group">
                <label>Secteur</label>
                <select name="category">
                    <option value="">Tous les secteurs</option>
                    <option value="Informatique">Informatique</option>
                    <option value="Data">Data</option>
                    <option value="Energie">Energie</option>
                    <option value="Management">Management</option>
                </select>
            </div>

            <div class="input-group">
                <label>Salaire minimum (€)</label>
                <input type="number" name="min_salary" placeholder="ex: 2000">
            </div>

            <div class="input-group">
                <label>Durée (mois)</label>
                <input type="number" name="duration" placeholder="ex: 6">
            </div>

            <button type="submit" class="btn-submit">Appliquer</button>
        </form>
    </aside>

    <section class="liste-offres">
        
        <p class="result-count">
            {{ offers|length }} offres trouvées
        </p>

        {# Setup pagination #}
        {% set per_page = 10 %}
        {% set total_pages = (offers|length / per_page)|round(0, 'ceil') %}
        {% set current_page = current_page is defined ? current_page : 1 %}
        {% set paged_offers = offers|slice((current_page - 1) * per_page, per_page) %}

        {% for offer in paged_offers %}
            <article>
                <div class="offre-header">
                    <h3>{{ offer.CompanyName|default('Entreprise non précisée') }}</h3>
                    <p class="offre-title-text">{{ offer.Title }}</p>
                </div>

                <div class="tags-container">
                    <span class="tag">{{ offer.Category }}</span>
                    <span class="tag">{{ offer.Duration }} mois</span>
                    <span class="tag">{{ offer.Salary }} €</span>
                </div>
                
                <div class="offre-actions">
                    <a href="/postuler/{{ offer.ID_offer }}" class="btn-postuler">Voir l'offre</a>
                </div>
            </article>
        {% else %}
            <div class="widget no-results">
                <h3>Aucune offre trouvée 😢</h3>
                <p>Essayez de modifier vos filtres ou de faire une recherche plus large.</p>
            </div>
        {% endfor %}

        {% if total_pages > 1 %}
            <nav class="pagination">
                {% if current_page > 1 %}
                    <a href="?q={{ app.request.query.get('q') }}&category={{ app.request.query.get('category') }}&min_salary={{ app.request.query.get('min_salary') }}&duration={{ app.request.query.get('duration') }}&page={{ current_page - 1 }}" class="pagination-btn">&laquo; Précédent</a>
                {% else %}
                    <span class="pagination-btn disabled">&laquo; Précédent</span>
                {% endif %}

                {% for page in 1..total_pages %}
                    {% if page == current_page %}
                        <span class="pagination-btn active">{{ page }}</span>
                    {% else %}
                        <a href="?q={{ app.request.query.get('q') }}&category={{ app.request.query.get('category') }}&min_salary={{ app.request.query.get('min_salary') }}&duration={{ app.request.query.get('duration') }}&page={{ page }}" class="pagination-btn">{{ page }}</a>
                    {% endif %}
                {% endfor %}

                {% if current_page < total_pages %}
                    <a href="?q={{ app.request.query.get('q') }}&category={{ app.request.query.get('category') }}&min_salary={{ app.request.query.get('min_salary') }}&duration={{ app.request.query.get('duration') }}&page={{ current_page + 1 }}" class="pagination-btn">Suivant &raquo;</a>
                {% else %}
                    <span class="pagination-btn disabled">Suivant &raquo;</span>
                {% endif %}
            </nav>
        {% endif %}

    </section>

</div>
{% endblock %}