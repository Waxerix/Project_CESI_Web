{% extends 'base.html.twig' %}

{% block content %}
    <div class="container">
        <form action="/admin/utilisateurs/results" method="post" enctype="multipart/form-data">
            <input type="search" name="search" id="search" placeholder="Rechercher...">
            <select name="filter" id="filter">
                {% for role in roles %}
                    <option value="{{ role.Status }}">
                        {{ role.Status }}
                    </option>
                {% endfor %}
            </select>
        </form>
    </div>

    <div class="layout-principal">
        <section class="liste-offres">
            <h2>Résultats pour la recherche '{{ search }}'</h2>

            {# ===== SETUP PAGINATION ===== #}
            {# Nombre d'utilisateurs affichés par page #}
            {% set per_page = 10 %}
            {# Page courante #}
            {% set current_page = current_page is defined ? current_page : 1 %}
            {# Nombre total de pages calculé depuis la taille du tableau users #}
            {% set total_pages = (users|length / per_page)|round(0, 'ceil') %}
            {# On découpe le tableau pour n'afficher que les users de la page courante #}
            {% set paged_users = users|slice((current_page - 1) * per_page, per_page) %}
            {# ===== FIN SETUP ===== #}

            {% for user in paged_users %}
                <article class="offre-card">
                    <div class="offre-header">
                        <h3>{{ user.Name|default('Utilisateur') }} {{ user.Lastname|upper }}</h3>
                        <p class="offre-title">{{ user.Email }}</p>
                    </div>
                    <div class="offre-details">
                        {% if user.status %}
                            <h4 class="badge-status">Statut : {{ user.status }}</h4>
                        {% endif %}
                        {% if user.Phone_number %}
                            <h4>📞 {{ user.Phone_number }}</h4>
                        {% endif %}
                    </div>
                    <div class="offre-actions">
                        <a href="/utilisateur/{{ user.ID_user }}" class="btn-postuler">Voir le profil</a>
                    </div>
                </article>
            {% else %}
                <p>Aucun utilisateur trouvé dans la base de données.</p>
            {% endfor %}

            {# Boutons de navigation, affichés seulement s'il y a plus d'une page #}
            {% if total_pages > 1 %}
                <nav class="pagination">
                    {% if current_page > 1 %}
                        <a href="?search={{ search }}&filter={{ filter }}&page={{ current_page - 1 }}" class="pagination-btn">&laquo; Précédent</a>
                    {% else %}
                        <span class="pagination-btn disabled">&laquo; Précédent</span>
                    {% endif %}

                    {% for page in 1..total_pages %}
                        {% if page == current_page %}
                            <span class="pagination-btn active">{{ page }}</span>
                        {% else %}
                            <a href="?search={{ search }}&filter={{ filter }}&page={{ page }}" class="pagination-btn">{{ page }}</a>
                        {% endif %}
                    {% endfor %}

                    {% if current_page < total_pages %}
                        <a href="?search={{ search }}&filter={{ filter }}&page={{ current_page + 1 }}" class="pagination-btn">Suivant &raquo;</a>
                    {% else %}
                        <span class="pagination-btn disabled">Suivant &raquo;</span>
                    {% endif %}
                </nav>
            {% endif %}

        </section>

        <aside class="sidebar">
            <div class="widget alert-widget">
                <h3>Options :</h3>
                <form action="/admin/utilisateurs/create" method="get">
                    <button type="submit" class="btn-supprimer">Créer un compte</button>
                </form>
            </div>
            <div class="widget info-widget">
                <h3>Rôles disponibles</h3>
                <ul>
                    <li>✓ Admin : Gestion totale</li>
                    <li>✓ Pilote : Gestion de sa promotion</li>
                    <li>✓ Etudiant : Accès limité</li>
                </ul>
            </div>
        </aside>
    </div>
{% endblock %}
