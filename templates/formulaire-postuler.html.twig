{# Héritage Twig #}
{% extends 'base.html.twig' %}

{# Titre de la page #}
{% block title %}Postuler à une offre{% endblock %}

{% block content %}

<section>
    <h2>Postuler à cette offre</h2>

    <div>
        <h2>Nom de l'entreprise</h2>
        <p>Intitulé de l'offre</p>

        {# IMPORTANT : enctype nécessaire pour upload de fichiers #}
        <form method="post" enctype="multipart/form-data">

            {# Upload CV #}
            <label for="CV">Votre CV :</label>
            <input type="file" id="CV" name="CV" accept=".pdf,.docx,.doc" required>

            {# Upload lettre de motivation #}
            <label for="lettre-motivation">Lettre de motivation :</label>
            <input type="file"
                   id="lettre-motivation"
                   name="lettre-motivation"
                   accept=".pdf,.docx,.doc"
                   required>

            {# Commentaire optionnel #}
            <label for="commentaire">Vous voulez nous dire quelque chose ?</label>
            <input type="text" id="commentaire" name="commentaire">

            {# Bouton envoyer (manquait dans ton HTML) #}
            <input type="submit" value="Envoyer la candidature">

        </form>
    </div>

</section>

{% endblock %}