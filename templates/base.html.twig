<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# Bloc Twig pour que chaque page puisse changer le titre #}
    <title>{% block title %}SeSoMate{% endblock %}</title>

    <link rel="stylesheet" href="{{ ('style/style.css') }}">
</head>

<body>

<header>
    {% include "header.html.twig" %}
</header>

<main>
    {# Bloc qui sera remplacé par le contenu de chaque page (connexion, evaluation, index, etc.) #}
    {% block content %}{% endblock %}
</main>

<footer>
    {% include "footer.html.twig" %}
</footer>
</body>
</html>