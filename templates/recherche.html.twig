{# Héritage Twig #}
{% extends 'base.html.twig' %}

{# Titre de la page #}
{% block title %}Liste des entreprises{% endblock %}

{% block content %}

<div>
    <p>Résultats pour : ...</p>
    <p>Filtres : ...</p>
    <p>Trier par : ...</p>
</div>

<section>
    <h2>Entreprises disponibles</h2>

    {% for entreprise in entreprises %}
    <article>
        {# Bouton wishlist #}
        <button><img src="{{ entreprise.logo_wishlist|default('#') }}" alt="étoile de wishlist"></button>

        {# Nom entreprise #}
        <h3>{{ entreprise.nom }}</h3>

        {# Logo entreprise #}
        <img src="{{ entreprise.logo|default('#') }}" alt="logo du site">

        {# Contact et offres #}
        <h4>Contact de l'entreprise</h4>
        <p>Nombre d'offres : {{ entreprise.nombre_offres|default(0) }}</p>
        <a href="{{ path('entreprise_detail', {'id': entreprise.id|default(0)}) }}">En savoir plus</a>
    </article>
    {% else %}
    <p>Aucune entreprise disponible pour le moment.</p>
    {% endfor %}

</section>

{% endblock %}