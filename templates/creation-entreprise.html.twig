{# Héritage Twig #}
{% extends 'base.html.twig' %}

{# Titre de la page #}
{% block title %}Créer une entreprise{% endblock %}

{% block content %}

<main>

    <section>
        <h2>Créer votre entreprise</h2>

        <div>
            {# Formulaire de création d'entreprise #}
            <form method="post">

                {# Nom entreprise #}
                <label for="company_name">Nom de l'entreprise :</label>
                <input type="text" id="company_name" name="company_name" required>

                {# Téléphone #}
                <label for="numero_tel">Numéro de téléphone :</label>
                <input type="tel" id="numero_tel" name="numero_tel" required>

                {# Lieu #}
                <label for="location">Lieu :</label>
                <input type="text" id="location" name="location" required>

                {# Email #}
                <label for="email">Email :</label>
                <input type="email" id="email" name="email" required>

                {# Secteur activité #}
                <label for="secteur">Secteur d'activité :</label>
                <select id="secteur" name="secteur" required>
                    <option value="">Sélectionnez un secteur</option>
                    <option value="informatique">Informatique</option>
                    <option value="sante">Santé</option>
                    <option value="finance">Finance</option>
                    <option value="education">Éducation</option>
                    <option value="autre">Autre</option>
                </select>

                {# Taille entreprise #}
                <label for="taille">Taille d'entreprise :</label>
                <select id="taille" name="taille" required>
                    <option value="">Sélectionnez une taille</option>
                    <option value="startup">Startup</option>
                    <option value="pm">PME</option>
                    <option value="grande">Grande entreprise</option>
                </select>

                {# Type entreprise #}
                <label for="type">Type d'entreprise :</label>
                <select id="type" name="type" required>
                    <option value="">Sélectionnez un type</option>
                    <option value="privée">Privée</option>
                    <option value="public">Public</option>
                </select>

                {# Bouton submit #}
                <input type="submit" value="Créer l'entreprise">

            </form>
        </div>

    </section>

</main>

{% endblock %}